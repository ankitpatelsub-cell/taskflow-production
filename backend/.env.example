PORT=3001
NODE_ENV=development

# Frontend URL for CORS
CORS_ORIGIN=http://localhost:5173

# JWT secrets — change these to long random strings in production
JWT_SECRET=change_this_to_a_long_random_secret_32chars
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret

# AES-256 key for encrypting backup files (exactly 32 chars)
BACKUP_ENCRYPTION_KEY=change_this_backup_key_32chars__

# Backup schedule (cron syntax) — default: 2 AM daily
BACKUP_CRON=0 2 * * *

# Number of backup files to retain
BACKUP_RETENTION_DAYS=30
