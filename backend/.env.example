PORT=3001
NODE_ENV=development

# Frontend URL for CORS
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# PostgreSQL connection string
DATABASE_URL=postgresql://taskflow:taskflow@localhost:5432/taskflow
DATABASE_SSL=false

# JWT secrets — change these to long random strings in production
JWT_SECRET=change_this_to_a_long_random_secret_32chars
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret

# AES-256 key for encrypting backup files (exactly 32 chars)
BACKUP_ENCRYPTION_KEY=change_this_backup_key_32chars__

# Backup schedule (cron syntax) — default: 2 AM daily
BACKUP_CRON=0 2 * * *

# Number of backup files to retain
BACKUP_RETENTION_DAYS=30

# Email (SMTP) — leave blank to use console logging in dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=TaskFlow <noreply@taskflow.app>

# Stripe — leave blank to disable billing features
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=

# Google OAuth — leave blank to disable Google login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sentry error tracking — leave blank to use only server logs
SENTRY_DSN=
