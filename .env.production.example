# TaskFlow Production Environment Variables
# Copy this file to .env and fill in the values before deploying.
# Lines marked [REQUIRED] must be set — the app will refuse to start without them.
# Lines marked [OPTIONAL] can be left blank to disable the associated feature.

# ──────────────────────────────────────────────────────────────
# DATABASE  [REQUIRED]
# ──────────────────────────────────────────────────────────────

# PostgreSQL connection string used by the backend
DATABASE_URL=postgresql://taskflow:changeme@db:5432/taskflow

# Set to "true" only if your Postgres server requires SSL
DATABASE_SSL=false

# Password for the Postgres taskflow user (must match DATABASE_URL)
DB_PASSWORD=changeme

# ──────────────────────────────────────────────────────────────
# AUTHENTICATION  [REQUIRED]
# ──────────────────────────────────────────────────────────────

# Secret used to sign short-lived access JWTs (min 32 chars, keep secret)
JWT_SECRET=

# Secret used to sign long-lived refresh JWTs (min 32 chars, keep secret)
JWT_REFRESH_SECRET=

# ──────────────────────────────────────────────────────────────
# BACKUPS  [REQUIRED]
# ──────────────────────────────────────────────────────────────

# AES-256 key for encrypting database backups (exactly 32 chars)
BACKUP_ENCRYPTION_KEY=

# Cron schedule for automatic backups (default: 2 AM daily)
# [OPTIONAL]
BACKUP_CRON=0 2 * * *

# Number of days to retain old backups before deletion
# [OPTIONAL]
BACKUP_RETENTION_DAYS=30

# ──────────────────────────────────────────────────────────────
# APP URLS / DOMAIN  [REQUIRED for production HTTPS]
# ──────────────────────────────────────────────────────────────

# Your domain name, pointed at this VPS with an A record.
# Caddy uses this to request a free Let's Encrypt TLS certificate automatically.
# Leave as "localhost" for local testing (no HTTPS).
DOMAIN=localhost

# Public URL of the app (used in email links, OAuth redirects) — should match DOMAIN with https://
APP_URL=http://localhost

# Allowed CORS origin for browser requests — should match APP_URL
CORS_ORIGIN=http://localhost

# ──────────────────────────────────────────────────────────────
# EMAIL / SMTP  [OPTIONAL — emails disabled if not set]
# ──────────────────────────────────────────────────────────────

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@taskflow.app

# ──────────────────────────────────────────────────────────────
# STRIPE BILLING  [OPTIONAL — billing UI disabled if not set]
# ──────────────────────────────────────────────────────────────

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=

# ──────────────────────────────────────────────────────────────
# GOOGLE OAUTH  [OPTIONAL — Google login disabled if not set]
# ──────────────────────────────────────────────────────────────

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ──────────────────────────────────────────────────────────────
# OBSERVABILITY  [OPTIONAL]
# ──────────────────────────────────────────────────────────────

# Sentry DSN for error tracking (leave blank to disable)
SENTRY_DSN=

# ──────────────────────────────────────────────────────────────
# AI FEATURES  [OPTIONAL — rule-based fallback used if not set]
# ──────────────────────────────────────────────────────────────

ANTHROPIC_API_KEY=
