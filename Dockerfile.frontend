FROM node:22-alpine AS builder

WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ .
RUN npm run build

# Serve with Caddy (automatic HTTPS via Let's Encrypt)
FROM caddy:2-alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY Caddyfile /etc/caddy/Caddyfile
EXPOSE 80 443
